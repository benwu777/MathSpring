      "levelStage": "grade5",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "用數字 2、4、6 各一次排成所有兩位數，不可重複使用。這些兩位數的總和是多少？",
        "zh-Hans": "用数字 2、4、6 各一次排成所有两位数，不可重复使用。这些两位数的总和是多少？",
        "en": "Using the digits 2, 4, and 6, form all two-digit numbers without repetition. What is the sum of all such numbers?",
        "ja": "数字 2、4、6 をそれぞれ 1 回ずつ使って、できる 2 桁の数をすべて作ります（同じ数字は 2 回使えません）。これらの 2 桁の数の合計はいくつですか。"
      },
      "answer": {
        "zh-Hant": "答案是 264。",
        "zh-Hans": "答案是 264。",
        "en": "The answer is 264.",
        "ja": "答えは 264 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "可組成 24、26、42、46、62、64。",
          "十位總和是 2×(2+4+6)×10 = 240。",
          "個位總和是 2×(2+4+6) = 24。",
          "總和是 264。"
        ],
        "zh-Hans": [
          "可组成 24、26、42、46、62、64。",
          "十位总和是 2×(2+4+6)×10 = 240。",
          "个位总和是 2×(2+4+6) = 24。",
          "总和是 264。"
        ],
        "en": [
          "The numbers are 24, 26, 42, 46, 62, and 64.",
          "The tens-place contribution is 240.",
          "The ones-place contribution is 24.",
          "So the total is 264."
        ],
        "ja": [
          "24、26、42、46、62、64 の 6 つの数ができます。",
          "十の位の合計は 2×(2+4+6)×10 = 240 です。",
          "一の位の合計は 2×(2+4+6) = 24 です。",
          "合計は 264 です。"
        ]
      },
