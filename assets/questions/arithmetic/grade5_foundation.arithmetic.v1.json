      "topic": "arithmetic",
      "subtopic": "average",
      "difficulty": "foundation",
      "levelStage": "grade5",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "三個數的平均是 18。前兩個數是 14 和 21。第三個數是多少？",
        "zh-Hans": "三个数的平均是 18。前两个数是 14 和 21。第三个数是多少？",
        "en": "The average of three numbers is 18. The first two are 14 and 21. What is the third number?",
        "ja": "3 つの数の平均は 18 です。最初の 2 つの数は 14 と 21 です。3 つ目の数はいくつですか。"
      },
      "answer": {
        "zh-Hant": "答案是 19。",
        "zh-Hans": "答案是 19。",
        "en": "The answer is 19.",
        "ja": "答えは 19 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "三個數總和是 18×3 = 54。",
          "前兩個數和是 14 + 21 = 35。",
          "第三個數是 54 - 35 = 19。"
        ],
        "zh-Hans": [
          "三个数总和是 18×3 = 54。",
          "前两个数和是 14 + 21 = 35。",
          "第三个数是 54 - 35 = 19。"
        ],
        "en": [
          "The total of the three numbers is 18×3 = 54.",
          "The first two add to 35.",
          "So the third is 54 - 35 = 19."
        ],
        "ja": [
          "3 つの数の合計は 18×3 = 54 です。",
          "最初の 2 つの数の和は 14 + 21 = 35 です。",
          "3 つ目の数は 54 - 35 = 19 です。"
        ]
      },
