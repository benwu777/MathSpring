    {
      "id": "algebra_grade8_foundation_001",
      "topic": "algebra",
      "subtopic": "quadratic_roots",
      "difficulty": "foundation",
      "levelStage": "grade8",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "若 5 是方程式 ax² + 4ax - 45 = 0 的一個根，求另一個根。",
        "zh-Hans": "若 5 是方程式 ax² + 4ax - 45 = 0 的一个根，求另一个根。",
        "en": "If 5 is a root of ax² + 4ax - 45 = 0, find the other root.",
        "ja": "5 が方程式 ax² + 4ax - 45 = 0 の解の 1 つです。もう 1 つの解を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 -9。",
        "zh-Hans": "答案是 -9。",
        "en": "The answer is -9.",
        "ja": "答えは -9 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "把 x = 5 代入，得 25a + 20a - 45 = 0。",
          "所以 45a = 45，因此 a = 1。",
          "原方程變成 x² + 4x - 45 = 0 = (x - 5)(x + 9)。",
          "另一個根是 -9。"
        ],
        "zh-Hans": [
          "把 x = 5 代入，得 25a + 20a - 45 = 0。",
          "所以 45a = 45，因此 a = 1。",
          "原方程变成 x² + 4x - 45 = 0 = (x - 5)(x + 9)。",
          "另一个根是 -9。"
        ],
        "en": [
          "Substitute x = 5 to get 25a + 20a - 45 = 0.",
          "So 45a = 45 and a = 1.",
          "Then the equation is x² + 4x - 45 = (x - 5)(x + 9).",
          "The other root is -9."
        ],
        "ja": [
          "x = 5 を代入すると 25a + 20a - 45 = 0。",
          "よって 45a = 45 なので a = 1。",
          "方程式は x² + 4x - 45 = (x - 5)(x + 9)。",
          "もう 1 つの解は -9 です。"
        ]
      },
