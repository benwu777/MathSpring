      "prompt": {
        "zh-Hant": "若 x + y = 10，xy = 21，求 x^2 + y^2。",
        "zh-Hans": "若 x + y = 10，xy = 21，求 x^2 + y^2。",
        "en": "If x + y = 10 and xy = 21, find x^2 + y^2.",
        "ja": "x + y = 10、xy = 21 のとき、x^2 + y^2 を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 58。",
        "zh-Hans": "答案是 58。",
        "en": "The answer is 58.",
        "ja": "答えは 58 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "利用恆等式 (x + y)^2 = x^2 + 2xy + y^2。",
          "所以 x^2 + y^2 = (x + y)^2 - 2xy。",
          "代入得 x^2 + y^2 = 10^2 - 2×21 = 100 - 42 = 58。"
        ],
        "zh-Hans": [
          "利用恒等式 (x + y)^2 = x^2 + 2xy + y^2。",
          "所以 x^2 + y^2 = (x + y)^2 - 2xy。",
          "代入得 x^2 + y^2 = 10^2 - 2×21 = 100 - 42 = 58。"
        ],
        "en": [
          "Use the identity (x + y)^2 = x^2 + 2xy + y^2.",
          "So x^2 + y^2 = (x + y)^2 - 2xy.",
          "Substitute the given values: 10^2 - 2·21 = 58."
        ],
        "ja": [
          "恒等式 (x + y)^2 = x^2 + 2xy + y^2 を使います。",
          "したがって x^2 + y^2 = (x + y)^2 - 2xy。",
          "10^2 - 2×21 = 58 です。"
        ]
      },
