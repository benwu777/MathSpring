      "difficulty": "foundation",
      "levelStage": "grade8",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "非零實數 a、b 滿足 5(a^2 + b^2) = (2a + b)^2，求 a/b。",
        "zh-Hans": "非零实数 a、b 满足 5(a^2 + b^2) = (2a + b)^2，求 a/b。",
        "en": "Nonzero real numbers a and b satisfy 5(a^2 + b^2) = (2a + b)^2. Find a/b.",
        "ja": "0 でない実数 a, b が 5(a^2 + b^2) = (2a + b)^2 を満たすとき、a/b を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 2。",
        "zh-Hans": "答案是 2。",
        "en": "The answer is 2.",
        "ja": "答えは 2 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "展開右邊得 4a^2 + 4ab + b^2。",
          "移項後得到 a^2 - 4ab + 4b^2 = 0。",
          "也就是 (a - 2b)^2 = 0。",
          "所以 a = 2b，因此 a/b = 2。"
        ],
        "zh-Hans": [
          "展开右边得 4a^2 + 4ab + b^2。",
          "移项后得到 a^2 - 4ab + 4b^2 = 0。",
          "也就是 (a - 2b)^2 = 0。",
          "所以 a = 2b，因此 a/b = 2。"
        ],
        "en": [
          "Expand the right-hand side to get 4a^2 + 4ab + b^2.",
          "Move everything to one side: a^2 - 4ab + 4b^2 = 0.",
          "This is (a - 2b)^2 = 0.",
          "Hence a = 2b, so a/b = 2."
        ],
        "ja": [
          "右辺を展開すると 4a^2 + 4ab + b^2。",
          "移項して a^2 - 4ab + 4b^2 = 0。",
          "これは (a - 2b)^2 = 0 です。",
          "したがって a = 2b、よって a/b = 2。"
        ]
      },
