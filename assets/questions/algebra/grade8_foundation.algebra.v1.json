    {
      "id": "algebra_grade8_foundation_002",
      "topic": "algebra",
      "subtopic": "linear_system",
      "difficulty": "foundation",
      "levelStage": "grade8",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "兩直線 3x - 2y = 5 與 ax + y = 7 的交點是 (1, b)。求 a×b。",
        "zh-Hans": "两直线 3x - 2y = 5 与 ax + y = 7 的交点是 (1, b)。求 a×b。",
        "en": "The lines 3x - 2y = 5 and ax + y = 7 intersect at (1, b). Find a×b.",
        "ja": "直線 3x - 2y = 5 と ax + y = 7 の交点が (1, b) です。a×b を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 -8。",
        "zh-Hans": "答案是 -8。",
        "en": "The answer is -8.",
        "ja": "答えは -8 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "把 (1, b) 代入 3x - 2y = 5，得 3 - 2b = 5，所以 b = -1。",
          "再代入 ax + y = 7，得 a - 1 = 7，所以 a = 8。",
          "因此 a×b = 8×(-1) = -8。"
        ],
        "zh-Hans": [
          "把 (1, b) 代入 3x - 2y = 5，得 3 - 2b = 5，所以 b = -1。",
          "再代入 ax + y = 7，得 a - 1 = 7，所以 a = 8。",
          "因此 a×b = 8×(-1) = -8。"
        ],
        "en": [
          "Substitute (1, b) into 3x - 2y = 5 to get b = -1.",
          "Then substitute into ax + y = 7 to get a = 8.",
          "So a×b = -8."
        ],
        "ja": [
          "(1, b) を 3x - 2y = 5 に代入すると b = -1。",
          "次に ax + y = 7 に代入すると a = 8。",
          "したがって a×b = -8 です。"
        ]
      },
