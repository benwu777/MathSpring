      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "一個等比數列中，第 2 項是 6，第 5 項是 48。求第 4 項。",
        "zh-Hans": "一个等比数列中，第 2 项是 6，第 5 项是 48。求第 4 项。",
        "en": "In a geometric sequence, the 2nd term is 6 and the 5th term is 48. Find the 4th term.",
        "ja": "ある等比数列で、第 2 項は 6、第 5 項は 48 です。第 4 項を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 24。",
        "zh-Hans": "答案是 24。",
        "en": "The answer is 24.",
        "ja": "答えは 24 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "設首項 a、公比 r，則第 2 項 ar = 6、第 5 項 ar⁴ = 48。",
          "兩式相除得 r³ = 48 ÷ 6 = 8，所以 r = 2。",
          "由 ar = 6 得 a = 3。",
          "第 4 項是 ar³ = 3 × 8 = 24。"
        ],
        "zh-Hans": [
          "设首项 a、公比 r，则第 2 项 ar = 6、第 5 项 ar⁴ = 48。",
          "两式相除得 r³ = 48 ÷ 6 = 8，所以 r = 2。",
          "由 ar = 6 得 a = 3。",
          "第 4 项是 ar³ = 3 × 8 = 24。"
        ],
        "en": [
          "Let the first term be a and the ratio r. Then ar = 6 and ar⁴ = 48.",
          "Dividing gives r³ = 48 ÷ 6 = 8, so r = 2.",
          "From ar = 6 we get a = 3.",
          "The 4th term is ar³ = 3 × 8 = 24."
        ],
        "ja": [
          "初項を a、公比を r とすると、第 2 項 ar = 6、第 5 項 ar⁴ = 48。",
          "割ると r³ = 48 ÷ 6 = 8、よって r = 2。",
          "ar = 6 より a = 3。",
          "第 4 項は ar³ = 3 × 8 = 24。"
        ]
      },
