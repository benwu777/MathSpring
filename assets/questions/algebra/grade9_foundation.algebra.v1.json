      "difficulty": "foundation",
      "levelStage": "grade9",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "若 x + y = 7，且 x² + y² = 29，求 xy。",
        "zh-Hans": "若 x + y = 7，且 x² + y² = 29，求 xy。",
        "en": "If x + y = 7 and x² + y² = 29, find xy.",
        "ja": "x + y = 7、x² + y² = 29 のとき、xy を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 10。",
        "zh-Hans": "答案是 10。",
        "en": "The answer is 10.",
        "ja": "答えは 10 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "由 (x + y)² = x² + 2xy + y²。",
          "代入得 7² = 29 + 2xy。",
          "所以 49 = 29 + 2xy，故 2xy = 20，xy = 10。"
        ],
        "zh-Hans": [
          "由 (x + y)² = x² + 2xy + y²。",
          "代入得 7² = 29 + 2xy。",
          "所以 49 = 29 + 2xy，故 2xy = 20，xy = 10。"
        ],
        "en": [
          "Use (x + y)² = x² + 2xy + y².",
          "Substituting gives 7² = 29 + 2xy.",
          "So 49 = 29 + 2xy, hence xy = 10."
        ],
        "ja": [
          "(x + y)² = x² + 2xy + y² を使います。",
          "代入すると 7² = 29 + 2xy。",
          "49 = 29 + 2xy より xy = 10。"
        ]
      },
