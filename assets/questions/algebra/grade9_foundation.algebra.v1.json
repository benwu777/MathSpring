    {
      "id": "algebra_grade9_foundation_001",
      "topic": "algebra",
      "subtopic": "quadratic_graph",
      "difficulty": "foundation",
      "levelStage": "grade9",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "拋物線 y = 3x² - 2x - 5 與 x 軸交於兩點。求這兩個交點之間的距離。",
        "zh-Hans": "抛物线 y = 3x² - 2x - 5 与 x 轴交于两点。求这两个交点之间的距离。",
        "en": "The parabola y = 3x² - 2x - 5 meets the x-axis at two points. Find the distance between them.",
        "ja": "放物線 y = 3x² - 2x - 5 が x 軸と 2 点で交わります。その 2 点の距離を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 8/3。",
        "zh-Hans": "答案是 8/3。",
        "en": "The answer is 8/3.",
        "ja": "答えは 8/3 です。"
      },
      "solutionSteps": {
