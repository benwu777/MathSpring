      "prompt": {
        "zh-Hant": "若 x² + 4y² + 2x - 4y + 2 = 0，求 x + y。",
        "zh-Hans": "若 x² + 4y² + 2x - 4y + 2 = 0，求 x + y。",
        "en": "If x² + 4y² + 2x - 4y + 2 = 0, find x + y.",
        "ja": "x² + 4y² + 2x - 4y + 2 = 0 のとき、x + y を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 -1/2。",
        "zh-Hans": "答案是 -1/2。",
        "en": "The answer is -1/2.",
        "ja": "答えは -1/2 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "配方得 (x + 1)² + 4(y - 1/2)² = 0。",
          "平方項和為 0，只能各自都是 0。",
          "所以 x = -1，y = 1/2，故 x + y = -1/2。"
        ],
        "zh-Hans": [
          "配方得 (x + 1)² + 4(y - 1/2)² = 0。",
          "平方项和为 0，只能各自都是 0。",
          "所以 x = -1，y = 1/2，故 x + y = -1/2。"
        ],
        "en": [
          "Complete the square: (x + 1)² + 4(y - 1/2)² = 0.",
          "A sum of squares is zero only when each square is zero.",
          "Thus x = -1 and y = 1/2, so x + y = -1/2."
        ],
        "ja": [
          "平方完成すると (x + 1)² + 4(y - 1/2)² = 0。",
          "平方の和が 0 なので、それぞれ 0 です。",
          "よって x = -1、y = 1/2、x + y = -1/2。"
        ]
      },
