          "令 y = 0，得 3x² - 2x - 5 = 0。",
          "解得 x = -1 與 x = 5/3。",
          "兩交點都在 x 軸上，所以距離是 5/3 - (-1) = 8/3。"
        ],
        "zh-Hans": [
          "令 y = 0，得 3x² - 2x - 5 = 0。",
          "解得 x = -1 与 x = 5/3。",
          "两交点都在 x 轴上，所以距离是 5/3 - (-1) = 8/3。"
        ],
        "en": [
          "Set y = 0 to get 3x² - 2x - 5 = 0.",
          "The roots are x = -1 and x = 5/3.",
          "Since both points lie on the x-axis, their distance is 8/3."
        ],
        "ja": [
          "y = 0 とおくと 3x² - 2x - 5 = 0。",
          "解は x = -1 と x = 5/3。",
          "x 軸上の 2 点なので距離は 8/3 です。"
        ]
