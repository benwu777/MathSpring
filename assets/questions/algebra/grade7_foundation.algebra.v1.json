      "levelStage": "grade7",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "某款電腦連續兩次打九折後，現在售價是 81,000 元。原價是多少元？",
        "zh-Hans": "某款电脑连续两次打九折后，现在售价是 81,000 元。原价是多少元？",
        "en": "A computer is discounted by 10% twice in a row and now costs 81,000. What was the original price?",
        "ja": "あるパソコンは 10% 引きが 2 回続き、今の価格は 81,000 です。元の価格はいくらですか。"
      },
      "answer": {
        "zh-Hant": "答案是 100,000 元。",
        "zh-Hans": "答案是 100,000 元。",
        "en": "The answer is 100,000.",
        "ja": "答えは 100,000 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "連續兩次打九折，等於乘上 0.9 × 0.9 = 0.81。",
          "原價 × 0.81 = 81,000。",
          "原價 = 81,000 ÷ 0.81 = 100,000。"
        ],
        "zh-Hans": [
          "连续两次打九折，等于乘上 0.9 × 0.9 = 0.81。",
          "原价 × 0.81 = 81,000。",
          "原价 = 81,000 ÷ 0.81 = 100,000。"
        ],
        "en": [
          "Two 10% discounts mean multiplying by 0.81.",
          "So original price × 0.81 = 81,000.",
          "The original price is 81,000 ÷ 0.81 = 100,000."
        ],
        "ja": [
          "10% 引き 2 回は 0.81 倍です。",
          "したがって 元の価格 × 0.81 = 81,000。",
          "元の価格は 81,000 ÷ 0.81 = 100,000 です。"
        ]
      },
