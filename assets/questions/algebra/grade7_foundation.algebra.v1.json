          "連續兩次打九折，等於乘上 0.9 × 0.9 = 0.81。",
          "原價 × 0.81 = 81,000。",
          "原價 = 81,000 ÷ 0.81 = 100,000。"
        ],
        "zh-Hans": [
          "连续两次打九折，等于乘上 0.9 × 0.9 = 0.81。",
          "原价 × 0.81 = 81,000。",
          "原价 = 81,000 ÷ 0.81 = 100,000。"
        ],
        "en": [
