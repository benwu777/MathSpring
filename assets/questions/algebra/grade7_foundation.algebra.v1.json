    {
      "id": "algebra_grade7_foundation_004",
      "topic": "algebra",
      "subtopic": "digit_equation",
      "difficulty": "foundation",
      "levelStage": "grade7",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "一個兩位數的十位數字與個位數字和為 11。把數字顛倒後，得到的新兩位數比原數小 27。原來的兩位數是多少？",
        "zh-Hans": "一个两位数的十位数字与个位数字和为 11。把数字颠倒后，得到的新两位数比原数小 27。原来的两位数是多少？",
        "en": "A two-digit number has digits whose sum is 11. Reversing the digits gives a number 27 smaller than the original. What is the original number?",
        "ja": "ある 2 桁の数で、十の位と一の位の和は 11 です。数字を逆にすると元の数より 27 小さくなります。元の数を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 74。",
        "zh-Hans": "答案是 74。",
        "en": "The answer is 74.",
        "ja": "答えは 74 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "設十位數字是 a，個位數字是 b。則 a + b = 11。",
          "原數是 10a + b，顛倒後是 10b + a。",
          "由題意得 (10a + b) - (10b + a) = 27，所以 9(a - b) = 27，故 a - b = 3。",
          "聯立 a + b = 11 與 a - b = 3，得 a = 7、b = 4，所以原數是 74。"
        ],
        "zh-Hans": [
          "设十位数字是 a，个位数字是 b。则 a + b = 11。",
          "原数是 10a + b，颠倒后是 10b + a。",
          "由题意得 (10a + b) - (10b + a) = 27，所以 9(a - b) = 27，故 a - b = 3。",
          "联立 a + b = 11 与 a - b = 3，得 a = 7、b = 4，所以原数是 74。"
        ],
        "en": [
          "Let the tens digit be a and the ones digit be b, so a + b = 11.",
          "The original number is 10a + b, and the reversed number is 10b + a.",
          "Their difference is 27, so 9(a - b) = 27 and hence a - b = 3.",
          "Solving a + b = 11 and a - b = 3 gives a = 7 and b = 4, so the original number is 74."
        ],
        "ja": [
          "十の位を a、一の位を b とすると a + b = 11。",
          "元の数は 10a + b、逆にした数は 10b + a。",
          "差が 27 なので 9(a - b) = 27、したがって a - b = 3。",
          "a + b = 11 と a - b = 3 を解くと a = 7、b = 4。よって元の数は 74 です。"
        ]
      },
