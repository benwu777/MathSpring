    {
      "id": "geometry_grade9_foundation_003",
      "topic": "geometry",
      "subtopic": "reflection_coordinate",
      "difficulty": "foundation",
      "levelStage": "grade9",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "原點關於直線 y = 2x + 1 的對稱點坐標是什麼？",
        "zh-Hans": "原点关于直线 y = 2x + 1 的对称点坐标是什么？",
        "en": "What is the reflection of the origin across the line y = 2x + 1?",
        "ja": "原点を直線 y = 2x + 1 について対称移動した点の座標を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 (-4/5, 2/5)。",
        "zh-Hans": "答案是 (-4/5, 2/5)。",
        "en": "The answer is (-4/5, 2/5).",
        "ja": "答えは (-4/5, 2/5) です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "設對稱點是 (a, b)。",
          "原點與對稱點的中點在直線 y = 2x + 1 上，所以 b/2 = 2(a/2) + 1。",
          "連接原點與對稱點的線段必垂直於直線，所以它的斜率是 -1/2。",
          "聯立可得 a = -4/5，b = 2/5。"
        ],
        "zh-Hans": [
          "设对称点是 (a, b)。",
          "原点与对称点的中点在直线 y = 2x + 1 上，所以 b/2 = 2(a/2) + 1。",
          "连接原点与对称点的线段必垂直于直线，所以它的斜率是 -1/2。",
          "联立可得 a = -4/5，b = 2/5。"
        ],
        "en": [
          "Let the reflected point be (a, b).",
          "Its midpoint with the origin lies on y = 2x + 1, so b/2 = a + 1.",
          "The segment from the origin to the reflected point is perpendicular to the line, so its slope is -1/2.",
          "Solving gives (a, b) = (-4/5, 2/5)."
        ],
        "ja": [
          "対称点を (a, b) とします。",
          "原点との中点は y = 2x + 1 上にあるので b/2 = a + 1。",
          "また原点と対称点を結ぶ線分はこの直線に垂直なので傾きは -1/2。",
          "これを解くと (a, b) = (-4/5, 2/5) です。"
        ]
      },
