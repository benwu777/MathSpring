      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "座標平面上有三點 A(1,1)、B(5,1)、C(3,6)。求三角形 ABC 的面積。",
        "zh-Hans": "坐标平面上有三点 A(1,1)、B(5,1)、C(3,6)。求三角形 ABC 的面积。",
        "en": "On the coordinate plane, points A(1,1), B(5,1), and C(3,6) form triangle ABC. Find its area.",
        "ja": "座標平面上の 3 点 A(1,1)、B(5,1)、C(3,6) が三角形 ABC を作ります。その面積を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 10。",
        "zh-Hans": "答案是 10。",
        "en": "The answer is 10.",
        "ja": "答えは 10 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "AB 是水平線段，長度是 5 - 1 = 4。",
          "點 C 到直線 AB 的高是 6 - 1 = 5。",
          "所以面積 = 1/2 × 4 × 5 = 10。"
        ],
        "zh-Hans": [
          "AB 是水平线段，长度是 5 - 1 = 4。",
          "点 C 到直线 AB 的高是 6 - 1 = 5。",
          "所以面积 = 1/2 × 4 × 5 = 10。"
        ],
        "en": [
          "Segment AB is horizontal, so its length is 5 - 1 = 4.",
          "The height from C to line AB is 6 - 1 = 5.",
          "Thus the area is (1/2)×4×5 = 10."
        ],
        "ja": [
          "AB は水平な線分なので長さは 5 - 1 = 4。",
          "点 C から直線 AB までの高さは 6 - 1 = 5。",
          "したがって面積は 1/2 × 4 × 5 = 10 です。"
        ]
      },
