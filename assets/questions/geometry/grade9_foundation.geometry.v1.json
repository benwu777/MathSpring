    {
      "id": "geometry_grade9_foundation_008",
      "topic": "geometry",
      "subtopic": "cone_to_cylinder_volume",
      "difficulty": "foundation",
      "levelStage": "grade9",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "一個倒圓錐形容器，底面半徑是 12 公分，高是 18 公分，裡面裝滿了水。把這些水全部倒進一個底面半徑 24 公分的直圓柱中。問圓柱中的水高是多少公分？",
        "zh-Hans": "一个倒圆锥形容器，底面半径是 12 公分，高是 18 公分，里面装满了水。把这些水全部倒进一个底面半径 24 公分的直圆柱中。问圆柱中的水高是多少公分？",
        "en": "An inverted cone with base radius 12 cm and height 18 cm is full of water. The water is poured into a cylinder with base radius 24 cm. What is the height of the water in the cylinder?",
        "ja": "底面の半径が 12 cm、高さが 18 cm の逆さ円すいが水で満たされています。この水を底面半径 24 cm の円柱にすべて注ぎました。円柱の水の高さは何 cm ですか。"
      },
      "answer": {
        "zh-Hant": "答案是 1.5。",
        "zh-Hans": "答案是 1.5。",
        "en": "The answer is 1.5.",
        "ja": "答えは 1.5 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "圓錐體積是 (1/3)πr²h = (1/3)π×12²×18 = 864π。",
          "倒入圓柱後體積不變，所以 π×24²×H = 864π。",
          "化簡得 576H = 864。",
          "因此 H = 864/576 = 3/2 = 1.5。"
        ],
        "zh-Hans": [
          "圆锥体积是 (1/3)πr²h = (1/3)π×12²×18 = 864π。",
          "倒入圆柱后体积不变，所以 π×24²×H = 864π。",
          "化简得 576H = 864。",
          "因此 H = 864/576 = 3/2 = 1.5。"
        ],
        "en": [
          "The cone volume is (1/3)πr²h = (1/3)π×12²×18 = 864π.",
          "Volume is preserved when the water is poured into the cylinder, so π×24²×H = 864π.",
          "This simplifies to 576H = 864.",
          "Hence H = 864/576 = 3/2 = 1.5."
        ],
        "ja": [
          "円すいの体積は (1/3)πr²h = (1/3)π×12²×18 = 864π です。",
          "円柱に移しても体積は変わらないので、π×24²×H = 864π。",
          "整理すると 576H = 864。",
          "したがって H = 864/576 = 3/2 = 1.5 です。"
        ]
      },
