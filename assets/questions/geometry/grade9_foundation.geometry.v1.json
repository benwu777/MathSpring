      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "在直角三角形 ABC 中，∠C = 90°，斜邊 AB = 26。若 M 是 AB 的中點，求 CM 的長度。",
        "zh-Hans": "在直角三角形 ABC 中，∠C = 90°，斜边 AB = 26。若 M 是 AB 的中点，求 CM 的长度。",
        "en": "In right triangle ABC, ∠C = 90° and hypotenuse AB = 26. If M is the midpoint of AB, find CM.",
        "ja": "直角三角形 ABC で ∠C = 90°、斜辺 AB = 26 とします。M が AB の中点なら、CM の長さを求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 13。",
        "zh-Hans": "答案是 13。",
        "en": "The answer is 13.",
        "ja": "答えは 13 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "直角三角形中，斜邊中點到三個頂點距離相等。",
          "所以 CM 等於斜邊的一半。",
          "CM = 26 ÷ 2 = 13。"
        ],
        "zh-Hans": [
          "直角三角形中，斜边中点到三个顶点距离相等。",
          "所以 CM 等于斜边的一半。",
          "CM = 26 ÷ 2 = 13。"
        ],
        "en": [
          "In a right triangle, the midpoint of the hypotenuse is equidistant from all three vertices.",
          "So CM equals half the hypotenuse.",
          "Hence CM = 26 / 2 = 13."
        ],
        "ja": [
          "直角三角形では、斜辺の中点は 3 頂点から等距離にあります。",
          "したがって CM は斜辺の半分です。",
          "CM = 26 ÷ 2 = 13。"
        ]
      },
