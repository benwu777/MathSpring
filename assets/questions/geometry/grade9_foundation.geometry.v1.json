    {
      "id": "geometry_grade9_foundation_001",
      "topic": "geometry",
      "subtopic": "folded_rectangle",
      "difficulty": "foundation",
      "levelStage": "grade9",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "如圖，長方形 ABCD 中，沿 BF 將三角形 BCF 對摺，使點 C 落到 AD 上的點 E。若 AB = 9，AE = 12，求 CF。",
        "zh-Hans": "如图，长方形 ABCD 中，沿 BF 将三角形 BCF 对折，使点 C 落到 AD 上的点 E。若 AB = 9，AE = 12，求 CF。",
        "en": "In rectangle ABCD, triangle BCF is folded along BF so that point C lands on point E on AD. If AB = 9 and AE = 12, find CF.",
        "ja": "長方形 ABCD で、三角形 BCF を BF に沿って折ると、点 C が AD 上の点 E に移ります。AB = 9、AE = 12 のとき、CF を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 5。",
        "zh-Hans": "答案是 5。",
        "en": "The answer is 5.",
        "ja": "答えは 5 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "摺疊後 BC = BE。",
          "因為 AB = 9、AE = 12，所以 BE = √(9² + 12²) = 15。",
          "依官方解法，利用相似三角形可得 EF = 5。",
          "又 EF = CF，因此 CF = 5。"
        ],
        "zh-Hans": [
          "折叠后 BC = BE。",
          "因为 AB = 9、AE = 12，所以 BE = √(9² + 12²) = 15。",
          "依官方解法，利用相似三角形可得 EF = 5。",
          "又 EF = CF，因此 CF = 5。"
        ],
        "en": [
          "After folding, BC = BE.",
          "Since AB = 9 and AE = 12, we have BE = 15.",
          "Using the similar triangles in the official solution gives EF = 5.",
          "Because EF = CF, the answer is 5."
        ],
        "ja": [
          "折り返しで BC = BE です。",
          "AB = 9、AE = 12 より BE = 15。",
          "公式解法の相似三角形から EF = 5。",
          "EF = CF なので CF = 5 です。"
        ]
      },
