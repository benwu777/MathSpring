    {
      "id": "geometry_grade8_foundation_002",
      "topic": "geometry",
      "subtopic": "folding_angle",
      "difficulty": "foundation",
      "levelStage": "grade8",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "長方形 ABCD 中，AB = 2，BC = 1，點 E 在 BC 上。把長方形沿 AE 對折後，點 B 恰好落在邊 CD 上。求 ∠EAB。",
        "zh-Hans": "长方形 ABCD 中，AB = 2，BC = 1，点 E 在 BC 上。把长方形沿 AE 对折后，点 B 恰好落在边 CD 上。求 ∠EAB。",
        "en": "In rectangle ABCD, AB = 2 and BC = 1. Point E lies on BC. After folding the rectangle along AE, point B lands on side CD. Find angle EAB.",
        "ja": "長方形 ABCD で AB = 2、BC = 1、E は BC 上の点です。AE に沿って折ると B が辺 CD 上に移ります。∠EAB を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 15°。",
        "zh-Hans": "答案是 15°。",
        "en": "The answer is 15 degrees.",
        "ja": "答えは 15° です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "對折後，B 的對應點 B' 在 CD 上，且 AB' = AB = 2。",
          "又 AD = 1，因此可得 ∠B'AD = 60°。",
          "因為 AE 是摺線，所以 ∠EAB = ∠EAB'。",
          "因此 ∠EAB = 15°。"
        ],
        "zh-Hans": [
          "对折后，B 的对应点 B' 在 CD 上，且 AB' = AB = 2。",
          "又 AD = 1，因此可得 ∠B'AD = 60°。",
          "因为 AE 是折线，所以 ∠EAB = ∠EAB'。",
          "因此 ∠EAB = 15°。"
        ],
        "en": [
          "After folding, the image B' of point B lies on CD and satisfies AB' = AB = 2.",
          "Using AD = 1 gives angle B'AD = 60 degrees.",
          "Because AE is the fold line, angle EAB equals angle EAB'.",
          "So angle EAB is 15 degrees."
        ],
        "ja": [
          "折った後、B の移った点 B' は CD 上にあり、AB' = AB = 2 です。",
          "また AD = 1 より ∠B'AD = 60° と分かります。",
          "AE は折り目なので ∠EAB = ∠EAB'。",
          "したがって ∠EAB = 15° です。"
        ]
      },
