      "id": "geometry_grade8_foundation_004",
      "topic": "geometry",
      "subtopic": "right_triangle_midpoint",
      "difficulty": "foundation",
      "levelStage": "grade8",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "直角三角形 ABC 中，∠C = 90°，AC = 6，BC = 8。若 M 是斜邊 AB 的中點，求 CM。",
        "zh-Hans": "直角三角形 ABC 中，∠C = 90°，AC = 6，BC = 8。若 M 是斜边 AB 的中点，求 CM。",
        "en": "In right triangle ABC, ∠C = 90°, AC = 6, and BC = 8. If M is the midpoint of hypotenuse AB, find CM.",
        "ja": "直角三角形 ABC で ∠C = 90°、AC = 6、BC = 8 とします。斜辺 AB の中点を M とするとき、CM を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 5。",
        "zh-Hans": "答案是 5。",
        "en": "The answer is 5.",
        "ja": "答えは 5 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "由畢氏定理，AB = √(6² + 8²) = 10。",
          "直角三角形斜邊中點到三個頂點距離相等。",
          "因此 CM = AB ÷ 2 = 5。"
        ],
        "zh-Hans": [
          "由勾股定理，AB = √(6² + 8²) = 10。",
          "直角三角形斜边中点到三个顶点距离相等。",
          "因此 CM = AB ÷ 2 = 5。"
        ],
        "en": [
          "By the Pythagorean theorem, AB = √(6² + 8²) = 10.",
          "In a right triangle, the midpoint of the hypotenuse is equidistant from all three vertices.",
          "Therefore CM = AB/2 = 5."
        ],
        "ja": [
          "三平方の定理より AB = √(6² + 8²) = 10。",
          "直角三角形では、斜辺の中点は 3 頂点から等距離です。",
          "したがって CM = AB ÷ 2 = 5 です。"
        ]
      },
