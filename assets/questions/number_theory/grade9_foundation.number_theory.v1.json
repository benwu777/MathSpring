      "id": "number_theory_grade9_foundation_010",
      "topic": "number_theory",
      "subtopic": "telescoping_product",
      "difficulty": "foundation",
      "levelStage": "grade9",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "計算乘積\n(1-1/2²)(1-1/3²)(1-1/4²)⋯(1-1/2026²)。",
        "zh-Hans": "计算乘积\n(1-1/2²)(1-1/3²)(1-1/4²)⋯(1-1/2026²)。",
        "en": "Compute the product\n(1-1/2²)(1-1/3²)(1-1/4²)⋯(1-1/2026²).",
        "ja": "積\n(1-1/2²)(1-1/3²)(1-1/4²)⋯(1-1/2026²)\nを求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 2027/4052。",
        "zh-Hans": "答案是 2027/4052。",
        "en": "The answer is 2027/4052.",
        "ja": "答えは 2027/4052 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "先把每一項拆開：1-1/n² = ((n-1)(n+1))/n² = ((n-1)/n)·((n+1)/n)。",
          "因此整個乘積變成 (1/2·2/3·3/4···2025/2026) × (3/2·4/3·5/4···2027/2026)。",
          "兩串大量約分後，第一串只剩 1/2026，第二串只剩 2027/2。",
          "所以乘積是 (1/2026)×(2027/2)。",
          "答案為 2027/4052。"
        ],
        "zh-Hans": [
          "先把每一项拆开：1-1/n² = ((n-1)(n+1))/n² = ((n-1)/n)·((n+1)/n)。",
          "因此整个乘积变成 (1/2·2/3·3/4···2025/2026) × (3/2·4/3·5/4···2027/2026)。",
          "两串大量约分后，第一串只剩 1/2026，第二串只剩 2027/2。",
          "所以乘积是 (1/2026)×(2027/2)。",
          "答案为 2027/4052。"
        ],
        "en": [
          "Rewrite each factor as 1-1/n² = ((n-1)(n+1))/n² = ((n-1)/n)((n+1)/n).",
          "So the whole product becomes (1/2·2/3·3/4·...·2025/2026) times (3/2·4/3·5/4·...·2027/2026).",
          "After telescoping, the first product becomes 1/2026 and the second becomes 2027/2.",
          "Multiplying gives (1/2026)(2027/2).",
          "Thus the value is 2027/4052."
        ],
        "ja": [
          "各項を 1-1/n² = ((n-1)(n+1))/n² = ((n-1)/n)((n+1)/n) と変形します。",
          "すると全体は (1/2·2/3·3/4·...·2025/2026) と (3/2·4/3·5/4·...·2027/2026) の積になります。",
          "どちらも大きく約分され、前者は 1/2026、後者は 2027/2 になります。",
          "したがって積は (1/2026)(2027/2)。",
          "答えは 2027/4052 です。"
        ]
      },
