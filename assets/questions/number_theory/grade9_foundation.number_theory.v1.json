    {
      "id": "number_theory_grade9_foundation_001",
      "topic": "number_theory",
      "subtopic": "integer_triangles",
      "difficulty": "foundation",
      "levelStage": "grade9",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "周長是 24 的整數邊三角形共有多少種？",
        "zh-Hans": "周长是 24 的整数边三角形共有多少种？",
        "en": "How many integer-sided triangles have perimeter 24?",
        "ja": "周の長さが 24 の整数辺三角形は何種類ありますか。"
      },
      "answer": {
        "zh-Hant": "答案是 15。",
        "zh-Hans": "答案是 15。",
        "en": "The answer is 15.",
        "ja": "答えは 15 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "設 a ≤ b ≤ c，且 a + b + c = 24。",
          "由三角形不等式得 a + b > c，所以 c < 12。",
          "逐一枚舉可得共有 15 組。"
        ],
        "zh-Hans": [
          "设 a ≤ b ≤ c，且 a + b + c = 24。",
          "由三角形不等式得 a + b > c，所以 c < 12。",
          "逐一枚举可得共有 15 组。"
        ],
        "en": [
          "Let a ≤ b ≤ c with a + b + c = 24.",
          "The triangle inequality gives c < 12.",
          "Enumerating the possible ordered triples gives 15 triangles."
        ],
        "ja": [
          "a ≤ b ≤ c、a + b + c = 24 とします。",
          "三角不等式から c < 12。",
          "場合を調べると 15 組あります。"
        ]
      },
