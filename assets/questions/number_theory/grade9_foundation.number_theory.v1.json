    {
      "id": "number_theory_grade9_foundation_008",
      "topic": "number_theory",
      "subtopic": "base_seven_digit_sum",
      "difficulty": "foundation",
      "levelStage": "grade9",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "小於 2019 的正整數中，把它寫成七進位後，各位數字和的最大值是多少？",
        "zh-Hans": "小于 2019 的正整数中，把它写成七进位后，各位数字和的最大值是多少？",
        "en": "Among the positive integers less than 2019, what is the greatest possible sum of the digits in base seven?",
        "ja": "2019 未満の正の整数を 7 進法で表したとき、各桁の和の最大値を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 22。",
        "zh-Hans": "答案是 22。",
        "en": "The answer is 22.",
        "ja": "答えは 22 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "先把 2019 轉成七進位：2019 = 5613_(7)。",
          "要讓各位數字和最大，就希望每一位盡量大，也就是盡量多用 6。",
