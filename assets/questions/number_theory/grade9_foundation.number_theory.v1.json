      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "求 3¹⁵ 除以 8 的餘數。",
        "zh-Hans": "求 3¹⁵ 除以 8 的余数。",
        "en": "Find the remainder when 3¹⁵ is divided by 8.",
        "ja": "3¹⁵ を 8 で割った余りを求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 3。",
        "zh-Hans": "答案是 3。",
        "en": "The answer is 3.",
        "ja": "答えは 3 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "3² = 9，除以 8 餘 1。",
          "所以 3¹⁴ = (3²)⁷ 除以 8 也餘 1。",
          "再乘一個 3，得 3¹⁵ 除以 8 餘 3。"
        ],
        "zh-Hans": [
          "3² = 9，除以 8 余 1。",
          "所以 3¹⁴ = (3²)⁷ 除以 8 也余 1。",
          "再乘一个 3，得 3¹⁵ 除以 8 余 3。"
        ],
        "en": [
          "Since 3² = 9 leaves remainder 1 modulo 8, 3¹⁴ = (3²)⁷ also leaves remainder 1.",
          "Multiplying by another 3 gives remainder 3 for 3¹⁵."
        ],
        "ja": [
          "3² = 9 は 8 で割ると余り 1 です。",
          "したがって 3¹⁴ = (3²)⁷ も余り 1。",
          "さらに 3 を掛けるので 3¹⁵ の余りは 3 です。"
        ]
