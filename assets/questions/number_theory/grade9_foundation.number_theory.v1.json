    {
      "id": "number_theory_grade9_foundation_004",
      "topic": "number_theory",
      "subtopic": "gcd_lcm_relation",
      "difficulty": "foundation",
      "levelStage": "grade9",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "兩個正整數的最大公因數是 6，最小公倍數是 126。其中一個數是 18，另一個數是多少？",
        "zh-Hans": "两个正整数的最大公因数是 6，最小公倍数是 126。其中一个数是 18，另一个数是多少？",
        "en": "Two positive integers have greatest common divisor 6 and least common multiple 126. One of the numbers is 18. What is the other number?",
        "ja": "2 つの正の整数の最大公約数は 6、最小公倍数は 126 です。一方が 18 のとき、もう一方を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 42。",
        "zh-Hans": "答案是 42。",
        "en": "The answer is 42.",
        "ja": "答えは 42 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "兩數乘積 = 最大公因數 × 最小公倍數。",
          "所以兩數乘積是 6 × 126 = 756。",
          "已知其中一個數是 18，另一個數是 756 ÷ 18 = 42。"
        ],
        "zh-Hans": [
          "两数乘积 = 最大公因数 × 最小公倍数。",
          "所以两数乘积是 6 × 126 = 756。",
          "已知其中一个数是 18，另一个数是 756 ÷ 18 = 42。"
        ],
        "en": [
          "The product of two positive integers equals their gcd times their lcm.",
          "So the product is 6 × 126 = 756.",
          "Since one number is 18, the other is 756 ÷ 18 = 42."
        ],
        "ja": [
          "2 つの正整数の積は、最大公約数と最小公倍数の積に等しいです。",
          "したがって積は 6 × 126 = 756。",
          "一方が 18 なので、もう一方は 756 ÷ 18 = 42 です。"
        ]
      },
