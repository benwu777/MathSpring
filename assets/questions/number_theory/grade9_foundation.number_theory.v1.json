      "id": "number_theory_grade9_foundation_005",
      "topic": "number_theory",
      "subtopic": "perfect_square_divisor",
      "difficulty": "foundation",
      "levelStage": "grade9",
      "challengeTier": "foundation",
      "prompt": {
        "zh-Hant": "最小的正整數 n，使得 72n 成為完全平方數，求 n。",
        "zh-Hans": "最小的正整数 n，使得 72n 成为完全平方数，求 n。",
        "en": "Find the smallest positive integer n such that 72n is a perfect square.",
        "ja": "72n が完全平方数になるような最小の正の整数 n を求めなさい。"
      },
      "answer": {
        "zh-Hant": "答案是 2。",
        "zh-Hans": "答案是 2。",
        "en": "The answer is 2.",
        "ja": "答えは 2 です。"
      },
      "solutionSteps": {
        "zh-Hant": [
          "72 = 2³ × 3²。",
          "完全平方數的質因數指數都要是偶數。",
          "目前只有 2 的指數是奇數，所以再乘一個 2 即可。",
          "因此最小的 n 是 2。"
        ],
        "zh-Hans": [
          "72 = 2³ × 3²。",
          "完全平方数的质因数指数都要是偶数。",
          "目前只有 2 的指数是奇数，所以再乘一个 2 即可。",
          "因此最小的 n 是 2。"
        ],
        "en": [
          "Factor 72 as 2³ × 3².",
          "In a perfect square, every prime exponent must be even.",
          "Only the exponent of 2 is odd, so multiply by one more 2.",
          "Thus the smallest n is 2."
        ],
        "ja": [
          "72 = 2³ × 3² と素因数分解します。",
          "完全平方数では各素因数の指数が偶数でなければなりません。",
          "2 の指数だけが奇数なので、さらに 2 を 1 つ掛ければよいです。",
          "したがって最小の n は 2 です。"
        ]
      },
